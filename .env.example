DATABASE_URL=postgresql://postgres:CHANGE_ME@localhost:5432/CalendarioApracom
PORT=3000
# Local: 127.0.0.1. Hosting: 0.0.0.0.
HOST=127.0.0.1
APP_ORIGIN=http://localhost:3000
NODE_ENV=development
# Completar con los datos del proveedor de correo de Apracom.
# Puerto 587: SMTP_SECURE=false (STARTTLS). Puerto 465: SMTP_SECURE=true.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
# Debe coincidir con un remitente autorizado por el proveedor.
SMTP_FROM="Salas Apracom <notificaciones@apracom-ec.com>"
# En producción: HTTPS, NODE_ENV=production y APP_ORIGIN=https://tu-dominio
